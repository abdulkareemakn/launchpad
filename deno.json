{
  "deploy": {
    "install": "deno run --unstable-unsafe-proto npm:pnpm@11.3.0/bin/pnpm.mjs install --frozen-lockfile",
    "build": "pnpm --filter @mern/client build && pnpm --filter @mern/server build",
    "runtime": {
      "type": "dynamic",
      "entrypoint": "apps/server/dist/deploy.js",
      "cwd": "."
    }
  }
}
