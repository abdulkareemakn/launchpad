{
  "name": "launchpad",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel --filter @mern/server --filter @mern/mail dev",
    "dev:ui": "bun run --filter @mern/client dev",
    "dev:mail": "bun run --filter @mern/emails dev",
    "build": "bun run --if-present --filter '*' build",
    "start": "bun run --filter @mern/server start",
    "typecheck": "bun check --no-script && bun run --if-present --filter '*' typecheck",
    "ui": "cd apps/client && bunx --bun shadcn@latest",
    "design": "designmd",
    "design:lint": "designmd lint DESIGN.md",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "bun run lint && oxfmt --check .",
    "format": "oxlint --fix && oxfmt .",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bun run --filter @mern/server test:unit",
    "test:integration": "bun run --filter @mern/server test:integration",
    "db:up": "docker compose -f compose.db.yaml up -d --wait",
    "db:down": "docker compose -f compose.db.yaml down",
    "docker:up": "docker compose up -d --build --wait",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@playwright/test": "^1.63.0",
    "@railway/cli": "^5.62.1",
    "@shadcn/lint": "0.2.0",
    "mongoose": "^9.10.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "railway": "^3.11.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "@railway/cli",
    "@scarf/scarf",
    "esbuild",
    "lightningcss"
  ]
}
